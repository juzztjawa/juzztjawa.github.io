---
import { siteConfig } from '../data/site';

const pathname = Astro.url.pathname;

interface Tab {
  href: string;
  label: string;
  icon: 'tsx' | 'md' | 'json';
  match: (p: string) => boolean;
}

const tabs: Tab[] = [
  {
    href: '/',
    label: 'index.tsx',
    icon: 'tsx',
    match: (p) => p === '/' || p === '',
  },
  {
    href: '/projects',
    label: 'projects.tsx',
    icon: 'tsx',
    match: (p) => p.startsWith('/projects'),
  },
  {
    href: '/blog',
    label: 'blog.md',
    icon: 'md',
    match: (p) => p.startsWith('/blog'),
  },
];

const iconColor: Record<Tab['icon'], string> = {
  tsx: '#56d4dd',
  md: '#79c0ff',
  json: '#ffb547',
};
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[#0b0f14]/85 border-b border-[#21262d]">
  <!-- Tab bar -->
  <nav class="flex items-center h-11 px-2 pl-3 bg-[#0b0f14] overflow-x-auto">
    {
      tabs.map((tab) => {
        const active = tab.match(pathname);
        return (
          <a
            href={tab.href}
            class={`editor-tab ${active ? 'active' : ''}`}
            data-active={active}
          >
            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 16 16" fill={iconColor[tab.icon]}>
              {tab.icon === 'tsx' && (
                <path d="M2 2h12v12H2V2zm5.5 8.5v1l-1.5.7v-.9l.7-.3-.7-.3v-.9l1.5.7zm3.7-2.7L9.3 11.5h-.7L10.5 8h.7zm-7.4 0v.6h1v3.1h.7V8.4h1V7.8h-2.7z" />
              )}
              {tab.icon === 'md' && (
                <path d="M14.85 3H1.15A1.15 1.15 0 000 4.15v7.7A1.15 1.15 0 001.15 13h13.7A1.15 1.15 0 0016 11.85v-7.7A1.15 1.15 0 0014.85 3zM9 11H7.5V7.5L6 9 4.5 7.5V11H3V5h1.5L6 6.5 7.5 5H9v6zm2.5.5L9.5 9H11V5h1v4h1.5l-2 2.5z" />
              )}
              {tab.icon === 'json' && (
                <path d="M5 2c-.6 0-1 .4-1 1v2c0 .6-.4 1-1 1H2v2h1c.6 0 1 .4 1 1v2c0 .6.4 1 1 1h1v-1H5V8H4V7h1V5h1V4h-1V3h1V2H5zm6 0h-1v1h1v1h1v2h1v1h-1v2h1v1h-1v1h-1v1h1c.6 0 1-.4 1-1V9c0-.6.4-1 1-1h1V6h-1c-.6 0-1-.4-1-1V3c0-.6-.4-1-1-1z" />
              )}
            </svg>
            <span>{tab.label}</span>
            <span class="editor-tab-close" aria-hidden="true">×</span>
          </a>
        );
      })
    }
    <div class="flex-1"></div>
    <div class="hidden md:flex items-center gap-2 pr-3 text-[10px] text-[#4a5563] tracking-widest uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950] animate-pulse"></span>
      <span>connected</span>
    </div>
    <div class="flex items-center gap-3 text-[#7d8590] pr-3 border-l border-[#21262d] pl-3 ml-1">
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#ffb547] transition-colors"
        aria-label="GitHub"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
        </svg>
      </a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#ffb547] transition-colors"
        aria-label="LinkedIn"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
    </div>
  </nav>
</header>
