---
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section id="projects" class="relative px-4 sm:px-8 max-w-5xl mx-auto py-20" data-section="projects">
  <SectionHeading title="projects" highlight="all" section="section 03 · dir/projects" viewAllHref="/projects" />

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {
      projects.map((project, i) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          image={project.data.heroImage}
          imageAlt={project.data.heroAlt}
          tags={project.data.tags}
          slug={project.id}
          index={i}
        />
      ))
    }
  </div>
</section>
